// Cloudflare config for the demo WEB APP (the static site served at
// fleet.oneuptech.co). The name is pinned so a Cloudflare Git build of this
// repo can only ever deploy the `fleetappdemo` worker, never SMT's `fleetapp`.
// The API has its own config in worker/wrangler.toml.
{
  "name": "fleetappdemo",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

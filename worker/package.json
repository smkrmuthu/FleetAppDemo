{
  "name": "fleet-ledger-demo-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "deploy": "wrangler deploy -c wrangler.toml",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fleet-ledger-demo-db --local -c wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply fleet-ledger-demo-db --remote -c wrangler.toml",
    "db:seed:local": "wrangler d1 execute fleet-ledger-demo-db --local --file=./seed.sql -c wrangler.toml",
    "db:seed:remote": "wrangler d1 execute fleet-ledger-demo-db --remote --file=./seed.sql -c wrangler.toml",
    "test": "vitest run",
    "secret:jwt": "wrangler secret put JWT_SECRET -c wrangler.toml",
    "secret:gemini": "wrangler secret put GEMINI_API_KEY -c wrangler.toml"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.129.0"
  }
}
